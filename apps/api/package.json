{
  "name": "@survey/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../../packages/survey-logic/dist/**/* src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "seed:clean": "tsx src/scripts/seed.ts --clean",
    "library:usage-benchmark": "tsx src/scripts/question-usage-benchmark.ts",
    "statistics:benchmark": "tsx src/scripts/statistics-benchmark.ts",
    "statistics:benchmark:clean": "tsx src/scripts/statistics-benchmark.ts --clean",
    "survey-list:benchmark": "tsx src/scripts/survey-list-benchmark.ts",
    "survey-list:benchmark:clean": "tsx src/scripts/survey-list-benchmark.ts --clean",
    "library:statistics-benchmark": "tsx src/scripts/library-statistics-benchmark.ts",
    "library:usage-audit": "tsx src/scripts/question-usage-audit.ts",
    "seed:stage2": "tsx src/scripts/seed-stage2.ts",
    "report:stage2-facts": "tsx src/scripts/stage2-report-facts.ts"
  },
  "dependencies": {
    "@survey/survey-logic": "0.1.0",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "mongoose": "9.11.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
