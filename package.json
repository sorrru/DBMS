{
  "name": "mongodb-survey-stage1",
  "version": "0.1.0",
  "private": true,
  "description": "基于 MongoDB 的版本化问卷系统第一阶段",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green \"npm run dev --workspace @survey/api\" \"npm run dev --workspace @survey/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "npm run seed --workspace @survey/api",
    "seed:clean": "npm run seed:clean --workspace @survey/api"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
